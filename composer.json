{
    "name": "codeconjure/sylius-carrier-bundle",
    "description": "Szállító-semleges Sylius-alap a szállító-pluginokhoz (FoxPost, GLS, Packeta): közös pénztár-mezők, validáció és hookok.",
    "type": "symfony-bundle",
    "keywords": ["symfony-ux", "sylius", "shipping", "carrier", "pickup-point"],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "sylius/sylius": "^2.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0 || ^13.0",
        "sylius-labs/coding-standard": "^4.4"
    },
    "autoload": {
        "psr-4": {
            "CodeConjure\\SyliusCarrierBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CodeConjure\\SyliusCarrierBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
